#!/usr/bin/env bash

logosctl daemon start &
DAEMON_PID=$!

until logosctl status > /dev/null 2>&1; do
  sleep 1
done

{% for module in logos_node_base_modules + logos_node_modules %}
logosctl module load {{ module }} || echo "WARNING: failed to load {{ module }}"
{% endfor %}

{% for cmd in logos_node_module_calls %}
logosctl call {{ cmd }} || echo "WARNING: failed: {{ cmd }}"
{% endfor %}
{% if logos_node_metrics_enabled | bool %}

logosctl call openmetrics start '{"port":{{ logos_node_metrics_port }},"modules":[{% for module in logos_node_modules %}{"name":"{{ module }}","format":"{{ "text" if module in logos_node_metrics_text_modules else "data" }}"}{{ "," if not loop.last }}{% endfor %}]}' || echo "WARNING: failed to start openmetrics"
{% endif %}

wait $DAEMON_PID